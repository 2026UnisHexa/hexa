# OpenAI API key — used ONLY by the Vercel serverless function (api/suggest-chords).
# Never prefix with VITE_ (that would expose the key to the browser bundle).
OPENAI_API_KEY=sk-your-key-here

# Backend base URL for login/signup (browser). Do NOT end with a trailing slash.
# Example: https://hexa-backend-68mi.onrender.com
VITE_API_BASE_URL=https://hexa-backend-68mi.onrender.com
